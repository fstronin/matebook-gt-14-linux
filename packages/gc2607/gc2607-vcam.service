[Unit]
Description=GC2607 virtual camera relay (libcamerasrc -> /dev/video60)
Documentation=file:///usr/share/doc/gc2607-camera-stack/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# IMPORTANT 1: v4l2-relayd parses -i as a single string (gst_parse_launch), and a caps
# filter inside such a string is not accepted by GStreamer 1.28 ('no element "video"').
# So only the element chain goes here: relayd takes the caps from -o (appsrc caps=…) and
# attaches them to the input pipeline's appsink, while videoconvert converts the camera
# format to YUY2.
#
# IMPORTANT 2: -o must contain a bounded "leaky" queue. Without it v4l2sink blocks the
# whole appsrc→videoconvert→v4l2sink chain, and the client gets ~1.7 fps instead of 30
# (measured: 1.7 fps without queue vs 26.6 fps with `queue leaky=upstream`).
# leaky=upstream drops old frames, so the output always carries a fresh picture.
#
# IMPORTANT 3: v4l2sink requires sync=false. By default basesink syncs output to the
# clock, while relayd feeds buffers via appsrc is-live=true/format=DEFAULT — basesink
# considers their timestamps late and drops them:
#   basesink gstbasesink.c: "A lot of buffers are being dropped"
#   basesink gstbasesink.c: "There may be a timestamping problem, or this computer is too slow"
# The result: the client gets 2-5 fps instead of ~27. For v4l2loopback clock sync is
# unnecessary: the client sets the pacing, hence sync=false (measured: 26.4 fps).
# IMPORTANT 4: when entering a session, the service may start before the v4l2loopback
# device becomes available (systemd-logind ACL on /dev/video60) — relayd then fails with
# "gst_element_set_state: assertion 'GST_IS_ELEMENT (element)' failed" and systemd brings
# it up again after RestartSec. We wait for the device for up to 10 s so the camera is in
# place right at login, and fail explicitly when the module is missing.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -e /dev/video60 ] && exit 0; sleep 0.2; done; echo "/dev/video60 did not appear: no v4l2loopback module for $(uname -r)?" >&2; exit 1'
ExecStart=/usr/bin/v4l2-relayd -i "libcamerasrc ! videoconvert" -o "appsrc name=appsrc caps=video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1 ! queue max-size-buffers=2 max-size-time=0 max-size-bytes=0 leaky=upstream ! videoconvert ! v4l2sink name=v4l2sink device=/dev/video60 sync=false"
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
